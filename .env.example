OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-6-luna
# Recruitment backend is disabled until server-owned credentials are configured.
# Generate separate random tokens (32+ characters) for each actor; never expose to a browser.
# JSON format: {"<random-token>":{"tenant_id":"company-a","actor_id":"hr-1","role":"hr"}}
# Supported roles: hr, recruiter. Never put real credentials in this example file.
RECRUITMENT_API_TOKENS_JSON={}
# Optional local HR Agent demo model calls (disabled by default; bounded per session).
RECRUITMENT_AGENT_DEMO_AI_ENABLED=0
# Luna owns requirement understanding, context and approved content.
RECRUITMENT_THINKING_MODEL=openai/gpt-6-luna
# Jev chooses bounded browser operation intents; it never writes free-form content.
RECRUITMENT_JEV_MODEL=typesafe/jev-1.13
# Optional path for public occupational research history; no HR/company input is stored.
# RECRUITMENT_TEMPLATE_HISTORY_DB=data/recruitment-history/templates.sqlite

# Report follow-up questions accept only explicitly approved models.
# REPORT_ASSISTANT_ALLOWED_MODELS=openai/gpt-6-luna
# COMPARISON_REPORT_DB=database/comparison_reports.sqlite3

# Recruitment backend: /api/recruitment/mvp (separate from analytics database)
# Defaults to database/recruitment.sqlite3. Never point at mismatch_system.db.
# RECRUITMENT_DATABASE_URL=postgresql+psycopg://recruitment:password@localhost:5432/recruitment
# Reuses OPENROUTER_API_KEY / OPENROUTER_MODEL above.
LLM_MODE=auto
OPENROUTER_TIMEOUT_SECONDS=20
# This setting only controls /api/recruitment/mvp/auth/register.
ALLOW_REGISTRATION=true
