OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-6-luna
# Recruitment backend is disabled until server-owned credentials are configured.
# Generate separate random tokens (32+ characters) for each actor; never expose to a browser.
# JSON format: {"<random-token>":{"tenant_id":"company-a","actor_id":"hr-1","role":"hr"}}
# Supported roles: hr, recruiter. Never put real credentials in this example file.
RECRUITMENT_API_TOKENS_JSON={}
# Optional local HR Agent demo model calls (disabled by default; bounded per session).
RECRUITMENT_AGENT_DEMO_AI_ENABLED=0
# Optional vision model for the external screenshot/mouse/keyboard Computer Use runner.
# Defaults to OPENROUTER_MODEL; never put credentials in the mock website.
RECRUITMENT_COMPUTER_MODEL=openai/gpt-6-luna
# Optional path for public occupational research history; no HR/company input is stored.
# RECRUITMENT_TEMPLATE_HISTORY_DB=data/recruitment-history/templates.sqlite
